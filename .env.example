# ══════════════════════════════════════════════════════════════════════════════
# TigerGraph Savanna — TWO separate auth planes
# ══════════════════════════════════════════════════════════════════════════════

# ── Control-plane (api.tgcloud.io) ────────────────────────────────────────────
# Savanna API key for managing workgroups/workspaces.
# Get it from: Savanna UI → Settings → API Keys
# Used to auto-discover your workspace hostname when TIGERGRAPH_HOST is blank.
# NOTE: variable name has a typo that must match your .env exactly.
TIGERGRAPGH_SAVANNA=

# ── Data-plane (workspace host) ───────────────────────────────────────────────
# Your workspace hostname.  Leave blank to auto-discover via TIGERGRAPGH_SAVANNA.
# Example: https://abc123.i.tgcloud.io
TIGERGRAPH_HOST=

# Graph name (must exist in your workspace)
TIGERGRAPH_GRAPH_NAME=FraudCaseGraph

# GSQL secret — used to obtain a Bearer token for REST++ queries.
# Get it from: GraphStudio → Admin Portal → User Management → Secrets
# OR: run  CREATE SECRET  in GSQL shell.
TIGERGRAPH_SECRET=

# Optional: pre-issued bearer token (skips getToken call if set)
TIGERGRAPH_TOKEN=

# Username / password (only needed for self-managed TigerGraph, not Savanna)
TIGERGRAPH_USERNAME=tigergraph
TIGERGRAPH_PASSWORD=

# ── TigerGraph MCP ────────────────────────────────────────────────────────────
TIGERGRAPH_MCP_URL=http://localhost:8765

# ══════════════════════════════════════════════════════════════════════════════
# LLM
# ══════════════════════════════════════════════════════════════════════════════
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest

# ══════════════════════════════════════════════════════════════════════════════
# GraphRAG
# ══════════════════════════════════════════════════════════════════════════════
GRAPHRAG_PROVIDER=tigergraph
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small

# ══════════════════════════════════════════════════════════════════════════════
# Persistence / App
# ══════════════════════════════════════════════════════════════════════════════
DATABASE_URL=sqlite:///./fraud_cases.db
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ══════════════════════════════════════════════════════════════════════════════
# Dataset paths (relative to project root)
# ══════════════════════════════════════════════════════════════════════════════
TRANSACTIONS_CSV=Datasets/transactions_clean.csv
IDENTITY_CSV=Datasets/identity.csv
CLOSED_CASES_CSV=Datasets/closed_cases_history.csv
CASE_PACK_CSV=Datasets/case_pack.csv
